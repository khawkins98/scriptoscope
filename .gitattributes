# Treat PNG bundle assets as binary so git doesn't try to LF-normalize them.
# The canonical theme bundles under themes/<slug>/cicns/ and ppats/ are
# pixel-faithful chrome that must round-trip byte-for-byte.
*.png binary

# JSON theme bundle output: keep LF only, no auto-CRLF on Windows checkouts.
themes/**/*.json text eol=lf

# Generated from tests/rendering-requirements/families/*.json by build-ledger.mjs; never hand-merge.
# Optional local driver: git config merge.scriptoscope-ledger.driver true (keeps one side; then run --write).
tests/rendering-requirements/ledger.json linguist-generated=true merge=scriptoscope-ledger
tests/rendering-requirements/families/*.json text eol=lf
